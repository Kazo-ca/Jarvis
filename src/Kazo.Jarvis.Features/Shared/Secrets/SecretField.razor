@inject ISecretVault Vault
@inject IStringLocalizer<SharedTexts> T

@* Secret field (stage 1 plan, work item 5): types an API key or a token into the vault (ADR 0004,
   section 4). The stored value is never read back nor shown; the field only says whether one exists. *@
<div class="secret-field" data-secret-ref="@Reference.Value" data-secret-status="@entry?.Status">
    <label class="secret-field-label" for="@inputId">@Label</label>
    <div class="secret-field-row">
        <input id="@inputId"
               class="secret-field-input"
               type="@(revealed ? "text" : "password")"
               autocomplete="off"
               spellcheck="false"
               placeholder="@(entry?.IsStored == true ? T["SecretReplacePlaceholder"] : T["SecretPlaceholder"])"
               @bind="draft"
               @bind:event="oninput" />
        <button type="button" class="secret-field-button" aria-pressed="@(revealed ? "true" : "false")" @onclick="() => revealed = !revealed">
            @(revealed ? T["SecretHide"] : T["SecretShow"])
        </button>
        <button type="button" class="secret-field-button secret-field-save" disabled="@string.IsNullOrWhiteSpace(draft)" @onclick="SaveAsync">
            @T["SecretSave"]
        </button>
        @if (entry?.IsStored == true)
        {
            <button type="button" class="secret-field-button secret-field-delete" @onclick="DeleteAsync">@T["SecretDelete"]</button>
        }
    </div>
    <p class="secret-field-status" role="status">@StatusText</p>
</div>

@code {
    private readonly string inputId = "secret-" + Guid.NewGuid().ToString("N")[..8];
    private SecretEntry? entry;
    private string? draft;
    private bool revealed;

    /// <summary>The reference of the secret, for instance <c>llm.anthropic.apikey</c>.</summary>
    [Parameter, EditorRequired]
    public SecretRef Reference { get; set; }

    /// <summary>Label of the field, already translated.</summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    /// <summary>Called after the secret was saved or deleted.</summary>
    [Parameter]
    public EventCallback<SecretEntryStatus> Changed { get; set; }

    private string StatusText => entry?.Status switch
    {
        SecretEntryStatus.NotSet => T["SecretNotSet"],
        SecretEntryStatus.Stored => T["SecretStored"],
        SecretEntryStatus.Saved => T["SecretSaved"],
        SecretEntryStatus.Deleted => T["SecretDeleted"],
        SecretEntryStatus.VaultUnavailable => T["SecretVaultUnavailable"],
        _ => string.Empty,
    };

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        if (entry is null || entry.Reference != Reference)
        {
            entry = new SecretEntry(Vault, Reference);
            await entry.LoadAsync();
        }
    }

    private async Task SaveAsync()
    {
        if (entry is not null && await entry.SaveAsync(draft))
        {
            // The typed secret leaves the page as soon as it is in the vault.
            draft = null;
            revealed = false;
            await Changed.InvokeAsync(entry.Status);
        }
    }

    private async Task DeleteAsync()
    {
        if (entry is not null)
        {
            await entry.DeleteAsync();
            await Changed.InvokeAsync(entry.Status);
        }
    }
}
