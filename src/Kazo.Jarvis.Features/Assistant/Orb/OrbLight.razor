@inherits OrbDrawing

@* The light version of the orb (UI catalog, section 3; ADR 0011): a still sphere in CSS gradients and three
   open rings turned by the browser's compositor (OrbLight.razor.js). *@
<span class="orb-body" @ref="Root">
    <span class="orb-glow"></span>
    <span class="orb-ring orb-ring-outer">
        <svg viewBox="0 0 200 200" aria-hidden="true" focusable="false">
            <defs>
                <linearGradient id="@($"{id}-g3")" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="currentColor" stop-opacity="0.9" />
                    <stop offset="1" stop-color="currentColor" stop-opacity="0.15" />
                </linearGradient>
            </defs>
            <path d="@Outer.Arc" fill="none" stroke="url(#@($"{id}-g3"))" stroke-width="1.6" />
            <path d="@Outer.FineTicks" fill="none" stroke="currentColor" stroke-width="0.6" stroke-opacity="0.45" />
            <path d="@Outer.Ticks" fill="none" stroke="currentColor" stroke-width="1.2" stroke-opacity="0.8" />
            <path d="@Outer.Cursor" fill="none" stroke="currentColor" stroke-width="2.5" stroke-opacity="0.6" />
            <path d="@Outer.Teeth" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
    </span>
    <span class="orb-ring orb-ring-middle">
        <svg viewBox="0 0 200 200" aria-hidden="true" focusable="false">
            <defs>
                <linearGradient id="@($"{id}-g2")" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="currentColor" stop-opacity="0.25" />
                    <stop offset="1" stop-color="currentColor" stop-opacity="1" />
                </linearGradient>
            </defs>
            <path d="@Middle.First" fill="none" stroke="url(#@($"{id}-g2"))" stroke-width="3.5" />
            <path d="@Middle.Second" fill="none" stroke="currentColor" stroke-width="3.5" stroke-opacity="0.75" />
            <path d="@Middle.Track" fill="none" stroke="currentColor" stroke-width="0.8" stroke-opacity="0.25" stroke-dasharray="1.5 3" />
            <path d="@Middle.Teeth" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
    </span>
    <span class="orb-ring orb-ring-inner">
        <svg viewBox="0 0 200 200" aria-hidden="true" focusable="false">
            <defs>
                <linearGradient id="@($"{id}-g1")" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="currentColor" stop-opacity="1" />
                    <stop offset="1" stop-color="currentColor" stop-opacity="0.25" />
                </linearGradient>
            </defs>
            <path d="@Inner.Arc" fill="none" stroke="url(#@($"{id}-g1"))" stroke-width="6" />
            <path d="@Inner.Track" fill="none" stroke="currentColor" stroke-width="1" stroke-opacity="0.35" />
            <path d="@Inner.Ticks" fill="none" stroke="currentColor" stroke-width="0.8" stroke-opacity="0.6" />
            <path d="@Inner.Teeth" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
        </svg>
    </span>
    <span class="orb-sphere"></span>
</span>

@code {
    private static readonly (string Arc, string FineTicks, string Ticks, string Cursor, string Teeth) Outer = (
        OrbGeometry.Arc(78, 120, 400),
        OrbGeometry.Ticks(78, 125, 395, 5, 3),
        OrbGeometry.Ticks(78, 130, 390, 30, 6),
        OrbGeometry.Arc(84, 140, 175),
        OrbGeometry.Teeth(78, 12, 120, 400));

    private static readonly (string First, string Second, string Track, string Teeth) Middle = (
        OrbGeometry.Arc(60, 200, 330),
        OrbGeometry.Arc(60, 10, 165),
        OrbGeometry.Arc(55, 0, 359),
        OrbGeometry.Teeth(60, 8, 10, 165, 200, 330));

    private static readonly (string Arc, string Track, string Ticks, string Teeth) Inner = (
        OrbGeometry.Arc(44, 30, 330),
        OrbGeometry.Arc(38.5, 40, 320),
        OrbGeometry.Ticks(49.5, 40, 320, 10, 2.5),
        OrbGeometry.Teeth(44, 11, 30, 330));

    // Gradient ids must be unique in the page: the demonstration may show several orbs.
    private readonly string id = "orb-" + Guid.NewGuid().ToString("N")[..8];

    /// <inheritdoc />
    protected override string ModulePath => "./_content/Kazo.Jarvis.Features/Assistant/Orb/OrbLight.razor.js";
}
