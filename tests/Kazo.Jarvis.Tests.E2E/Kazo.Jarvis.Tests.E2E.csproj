<Project Sdk="Microsoft.NET.Sdk">

  <!--
    End-to-end tests (ADR 0001): Playwright against the Web test host, started in process on a
    free port. Browsers are installed once with bin/<configuration>/net10.0/playwright.ps1 install chromium.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Playwright.NUnit" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NUnit.Analyzers" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kazo.Jarvis.Web\Kazo.Jarvis.Web.csproj" />
  </ItemGroup>

  <!--
    The scripts the browser of Jarvis runs in a results page (ADR 0022) are plain JavaScript in a plain .NET file
    of the Windows host: compiled here as well, so that Chromium runs them against pages written by hand.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\Kazo.Jarvis.Windows\Browser\SearchPages.cs" LinkBase="Windows\Browser" />
  </ItemGroup>

</Project>
